{
  "auto_indent_on_paste": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_family": "Monaspace Neon Var",
  "buffer_font_features": {
    "calt": true,
    "liga": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true,
    "ss09": true,
  },
  "buffer_font_size": 15,
  "cli_default_open_behavior": "existing_window",
  "code_lens": "off",
  "collaboration_panel": {
    "button": false,
    "default_width": 0,
  },
  "cursor_blink": false,
  "cursor_shape": "bar",
  "debugger": {
    "button": false,
  },
  "diagnostics": {
    "button": false,
  },
  "diff_view_style": "split",
  "disable_ai": true,
  "extend_comment_on_newline": false,
  "format_on_save": "on",
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "git_panel": {
    "button": true,
    "dock": "left",
  },
  "gutter": {
    "breakpoints": false,
    "folds": true,
    "line_numbers": true,
    "min_line_number_digits": 3,
    "runnables": false,
  },
  "icon_theme": {
    "dark": "Zed (Default)",
    "light": "Zed (Default)",
    "mode": "light",
  },
  "languages": {
    "Go": {
      "hard_tabs": true,
      "tab_size": 4,
    },
    "Java": {
      "format_on_save": "on",
      "tab_size": 4,
    },
    "Python": {
      "hard_tabs": false,
      "language_servers": ["ty", "!basedpyright", "!pyright", "!pylsp", "..."],
      "tab_size": 4,
    },
    "Rust": {
      "hard_tabs": false,
      "tab_size": 4,
    },
    "Swift": {
      "hard_tabs": true,
      "tab_size": 4,
    },
    "TSX": {
      "language_servers": ["vtsls", "!typescript-language-server", "..."],
    },
    "TypeScript": {
      "language_servers": ["vtsls", "!typescript-language-server", "..."],
    },
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx"],
        "experimental": {
          "classRegex": ["className=\"([^\"]*)\"", "class=\"([^\"]*)\""],
        },
      },
    },
  },
  "minimap": {
    "show": "never",
  },
  "outline_panel": {
    "button": false,
  },
  "project_panel": {
    "auto_fold_dirs": true,
    "button": true,
    "dock": "left",
    "indent_guides": {
      "show": "always",
    },
    "indent_size": 20,
    "sticky_scroll": true,
  },
  "relative_line_numbers": "enabled",
  "scrollbar": {
    "show": "auto",
  },
  "search": {
    "button": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "show_whitespaces": "selection",
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tab_size": 2,
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "show_close_button": "hidden",
  },
  "terminal": {
    "button": false,
  },
  "theme": {
    "dark": "Vesper",
    "light": "One Light",
    "mode": "dark",
  },
  "theme_overrides": {
    "Vesper": {
      "syntax": {
        "property.json_key": {
          "color": "#FFC799",
        },
      },
    },
  },
  "title_bar": {
    "show_branch_name": true,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_sign_in": false,
    "show_user_picture": false,
  },
  "toolbar": {
    "agent_review": false,
    "breadcrumbs": true,
    "code_actions": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "ui_font_size": 16,
  "vim_mode": true,
}

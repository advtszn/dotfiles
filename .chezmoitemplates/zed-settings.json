{
  "auto_indent_on_paste": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_family": "Monaspace Neon Var",
  "buffer_font_features": {
    "calt": true,
    "liga": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true,
    "ss09": true
  },
  "buffer_font_size": 14,
  "cli_default_open_behavior": "new_window",
  "code_lens": "off",
  "cursor_blink": false,
  "cursor_shape": "bar",
  "diff_view_style": "split",
  "disable_ai": true,
  "extend_comment_on_newline": false,
  "format_on_save": "on",
  "git_panel": {
    "dock": "left"
  },
  "gutter": {
    "line_numbers": true
  },
  "icon_theme": {
    "dark": "Zed (Default)",
    "light": "Zed (Default)",
    "mode": "light"
  },
  "languages": {
    "Go": {
      "hard_tabs": true,
      "tab_size": 4
    },
    "Java": {
      "format_on_save": "on",
      "tab_size": 4
    },
    "Python": {
      "hard_tabs": false,
      "language_servers": [
        "ty",
        "!basedpyright",
        "!pyright",
        "!pylsp",
        "..."
      ],
      "tab_size": 4
    },
    "Rust": {
      "hard_tabs": false,
      "tab_size": 4
    },
    "Swift": {
      "hard_tabs": true,
      "tab_size": 4
    },
    "TSX": {
      "language_servers": [
        "vtsls",
        "!typescript-language-server",
        "..."
      ]
    },
    "TypeScript": {
      "language_servers": [
        "vtsls",
        "!typescript-language-server",
        "..."
      ]
    }
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": [
          "cva",
          "cx"
        ],
        "experimental": {
          "classRegex": [
            "className=\"([^\"]*)\"",
            "class=\"([^\"]*)\""
          ]
        }
      }
    }
  },
  "project_panel": {
    "auto_fold_dirs": true,
    "dock": "left",
    "indent_guides": {
      "show": "always"
    },
    "indent_size": 20,
    "sticky_scroll": true
  },
  "relative_line_numbers": "enabled",
  "session": {
    "trust_all_worktrees": true
  },
  "show_whitespaces": "selection",
  "tab_size": 2,
  "tabs": {
    "file_icons": true
  },
  "theme": {
    "dark": "monoszn-dark",
    "light": "One Light",
    "mode": "dark"
  },
  "ui_font_size": 16,
  "vim_mode": true
}

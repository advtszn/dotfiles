{{- /* chezmoi:modify-template */ -}}
{{- /* Zed settings live in .chezmoitemplates/zed-settings.json (no ssh_connections).
       Local ssh_connections are kept from the existing file and never enter the repo.
       Spliced in as text (not re-serialized) so Zed's own formatting, trailing commas
       included, survives and chezmoi stops reporting a diff. */ -}}
{{- $base := includeTemplate "zed-settings.json" . -}}
{{- if .chezmoi.stdin -}}
{{-   $ssh := regexFind `(?ms)^  "ssh_connections"[:] \[.*?^  \],\n` .chezmoi.stdin -}}
{{-   if $ssh -}}
{{-     $base = replace "  \"status_bar\": {" (print $ssh "  \"status_bar\": {") $base -}}
{{-   end -}}
{{- end -}}
{{- $base -}}
